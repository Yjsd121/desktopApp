.Modal-container .Form-Style .Form-actions button:last-child:hover {
  background: #00c7bb;
  border-color: #00c7bb;
}

.Modal-container .Form-Style .Form-actions button:active {
  transform: scale(0.98);
}

.Modal-container .Form-Style textarea {
  width: 100%;
  min-height: 90px;
  padding: 10px 12px;
  box-sizing: border-box;
  background: #1d2a40;
  color: #dce5f2;
  border: 1px solid #344762;
  border-radius: 8px;
  outline: none;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  resize: vertical;
  transition:
    border-color 0.2s ease,
